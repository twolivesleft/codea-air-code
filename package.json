{
  "name": "codea-air-code",
  "displayName": "Codea Air Code",
  "description": "A remote editor and debugger for Codea projects.",
  "version": "1.3.9",
  "publisher": "twolivesleft",
  "license": "MIT",
  "homepage": "https://twolivesleft.github.io/codea-air-code/",
  "repository": {
    "type": "git",
    "url": "https://github.com/twolivesleft/codea-air-code.git"
  },
  "engines": {
    "vscode": "^1.76.0"
  },
  "icon": "images/codea.png",
  "galleryBanner": {
    "color": "#E0F8F4"
  },
  "bugs": {
    "url": "https://github.com/twolivesleft/codea-air-code/issues"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "keywords": [
    "lua",
    "codea",
    "ios",
    "debugger"
  ],
  "activationEvents": [
    "onFileSystem:codea",
    "workspaceContains:.vscode/settings.json",
    "onView:codea-projects"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codea-sidebar",
          "title": "Codea Sidebar",
          "icon": "resources/codea.svg"
        }
      ]
    },
    "views": {
      "codea-sidebar": [
        {
          "id": "codea-projects",
          "name": "Projects",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "codea-assets",
          "name": "Assets",
          "when": "codea-air-code.hasLocalHost"
        },
        {
          "type": "webview",
          "id": "codea-reference",
          "name": "Reference",
          "when": "codea-air-code.hasLocalHost"
        },
        {
          "type": "webview",
          "id": "codea-parameters",
          "name": "Parameters",
          "when": "codea-air-code.hasLocalHost"
        }
      ]
    },
    "commands": [
      {
        "command": "codea-air-code.executeLine",
        "title": "Codea: Execute current line"
      },
      {
        "command": "codea-air-code.executeSelection",
        "title": "Codea: Execute selection"
      },
      {
        "command": "codea-air-code.executeCommand",
        "title": "Codea: Execute command..."
      },
      {
        "command": "codea-air-code.restartProject",
        "title": "Codea: Restart project"
      },
      {
        "command": "codea-air-code.setRuntime",
        "title": "Codea: Set runtime..."
      },
      {
        "command": "codea-air-code.addDependency",
        "title": "Codea: Add dependency..."
      },
      {
        "command": "codea-air-code.selectionReference",
        "title": "Codea: Find reference..."
      },
      {
        "command": "codea-air-code.textReference",
        "title": "Codea: Find reference..."
      },
      {
        "command": "codea-air-code.moveToFolder",
        "title": "Codea: Move to a Local Folder..."
      },
      {
        "command": "codea-air-code.linkFolder",
        "title": "Codea: Link Folder to Project..."
      },
      {
        "command": "codea-air-code.syncLinkedFolders",
        "title": "Codea: Sync Linked Folders",
        "icon": "$(sync)"
      },
      {
        "command": "codea-air-code.showMenu",
        "title": "Codea: Show Menu"
      },
      {
        "command": "codea-air-code.showOutput",
        "title": "Codea: Show Output"
      },
      {
        "command": "codea-air-code.connect",
        "title": "Codea: Connect to Codea..."
      },
      {
        "command": "codea-air-code.refreshProjects",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "codea-air-code.getProject",
        "title": "Get Project",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codea-air-code.playProject",
        "title": "Play in Codea",
        "icon": "$(play)"
      },
      {
        "command": "codea-air-code.revealProject",
        "title": "Reveal Linked Folder",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codea-air-code.showWalkthrough",
        "title": "Codea: Get Started with Codea Projects"
      },
      {
        "command": "codea-air-code.getAllProjects",
        "title": "Codea: Get All Projects",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codea-air-code.linkAllFolders",
        "title": "Codea: Link All Matching Folders..."
      },
      {
        "command": "codea-air-code.getCollectionProjects",
        "title": "Get All Projects in Collection",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codea-air-code.newProject",
        "title": "Codea: New Project...",
        "icon": "$(codea-new)"
      },
      {
        "command": "codea-air-code.deleteProject",
        "title": "Codea: Delete Project in Codea...",
        "icon": "$(trash)"
      },
      {
        "command": "codea-air-code.removeDependency",
        "title": "Remove Dependency",
        "icon": "$(close)"
      },
      {
        "command": "codea-air-code.refreshAssets",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "codea-air-code.addAssetFiles",
        "title": "Add Files...",
        "icon": "$(add)"
      },
      {
        "command": "codea-air-code.renameAsset",
        "title": "Rename..."
      },
      {
        "command": "codea-air-code.deleteAsset",
        "title": "Delete"
      },
      {
        "command": "codea-air-code.linkAssetPack",
        "title": "Link to Folder",
        "icon": "$(link)"
      },
      {
        "command": "codea-air-code.revealAssetPack",
        "title": "Reveal Linked Folder",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codea-air-code.disconnect",
        "title": "Codea: Disconnect"
      },
      {
        "command": "codea-air-code.setUpGoToDefinition",
        "title": "Codea: Set Up Go to Definition"
      },
      {
        "command": "codea-air-code.unlinkFolder",
        "title": "Codea: Unlink Folder"
      },
      {
        "command": "codea-air-code.resolveConflicts",
        "title": "Codea: Resolve Sync Conflicts"
      },
      {
        "command": "codea-air-code.showLinkedProjectsOnly",
        "title": "Codea: Show Linked Projects Only",
        "icon": "$(filter)"
      },
      {
        "command": "codea-air-code.showAllProjects",
        "title": "Codea: Show All Projects",
        "icon": "$(filter-filled)"
      }
    ],
    "keybindings": [
      {
        "command": "codea-air-code.renameAsset",
        "key": "f2",
        "mac": "enter",
        "when": "focusedView == codea-assets"
      },
      {
        "command": "codea-air-code.deleteAsset",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == codea-assets"
      }
    ],
    "languages": [
      {
        "id": "codea-output",
        "mimetypes": [
          "text/x-codea-output"
        ]
      }
    ],
    "grammars": [
      {
        "language": "codea-output",
        "scopeName": "codea.output",
        "path": "./syntaxes/codea-output.tmLanguage"
      }
    ],
    "breakpoints": [
      {
        "language": "lua"
      }
    ],
    "debuggers": [
      {
        "type": "luaInline",
        "label": "Lua Debugger",
        "initialConfigurations": [
          {
            "name": "wait",
            "displayName": "Play in Codea",
            "type": "lua",
            "request": "attach",
            "sourceBasePath": "${workspaceRoot}",
            "listenPublicly": false,
            "listenPort": 56789,
            "encoding": "UTF-8"
          }
        ],
        "configurationAttributes": {
          "attach": {
            "required": [
              "name",
              "type",
              "request",
              "listenPublicly",
              "listenPort"
            ],
            "properties": {
              "sourceBasePath": {
                "type": "string",
                "description": "Base path of lua source files",
                "default": "${workspaceRoot}"
              },
              "listenPublicly": {
                "type": "boolean",
                "description": "Set this to true if the debuggee will run in different computer.",
                "default": false
              },
              "listenPort": {
                "type": "integer",
                "description": "Local TCP port to communicate between debug adapter and debuggee.",
                "default": 56789
              },
              "encoding": {
                "type": "string",
                "description": "Encoding of the debuggee. (Example: 'UTF-8', '949')",
                "default": "UTF-8"
              }
            }
          }
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == lua && editorHasSelection",
          "command": "codea-air-code.executeSelection",
          "group": "a_codea"
        },
        {
          "when": "resourceLangId == lua && !editorHasSelection",
          "command": "codea-air-code.executeLine",
          "group": "a_codea"
        },
        {
          "when": "resourceLangId == lua && editorHasSelection",
          "command": "codea-air-code.selectionReference",
          "group": "a_codea"
        }
      ],
      "commandPalette": [
        {
          "command": "codea-air-code.executeLine",
          "when": "workspaceFolderCount > 0 && editorLangId == lua"
        },
        {
          "command": "codea-air-code.executeSelection",
          "when": "workspaceFolderCount > 0 && editorLangId == lua"
        },
        {
          "command": "codea-air-code.executeCommand",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "codea-air-code.restartProject",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "codea-air-code.setRuntime",
          "when": "workspaceFolderCount > 0 && resourceLangId == lua"
        },
        {
          "command": "codea-air-code.addDependency",
          "when": "workspaceFolderCount > 0 && resourceLangId == lua"
        },
        {
          "command": "codea-air-code.textReference",
          "when": "workspaceFolderCount > 0 && resourceLangId == lua"
        },
        {
          "command": "codea-air-code.selectionReference",
          "when": "false"
        },
        {
          "command": "codea-air-code.moveToFolder",
          "when": "codea-air-code.isCodeaWindow"
        },
        {
          "command": "codea-air-code.syncLinkedFolders",
          "when": "codea-air-code.isLinked"
        },
        {
          "command": "codea-air-code.showMenu",
          "when": "false"
        },
        {
          "command": "codea-air-code.refreshProjects",
          "when": "false"
        },
        {
          "command": "codea-air-code.getProject",
          "when": "false"
        },
        {
          "command": "codea-air-code.playProject",
          "when": "false"
        },
        {
          "command": "codea-air-code.revealProject",
          "when": "false"
        },
        {
          "command": "codea-air-code.getAllProjects",
          "when": "codea-air-code.hasLocalHost"
        },
        {
          "command": "codea-air-code.linkAllFolders",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "codea-air-code.getCollectionProjects",
          "when": "false"
        },
        {
          "command": "codea-air-code.disconnect",
          "when": "codea-air-code.hasLocalHost"
        },
        {
          "command": "codea-air-code.newProject",
          "when": "codea-air-code.hasLocalHost"
        },
        {
          "command": "codea-air-code.deleteProject",
          "when": "false"
        },
        {
          "command": "codea-air-code.removeDependency",
          "when": "false"
        },
        {
          "command": "codea-air-code.refreshAssets",
          "when": "false"
        },
        {
          "command": "codea-air-code.addAssetFiles",
          "when": "false"
        },
        {
          "command": "codea-air-code.renameAsset",
          "when": "false"
        },
        {
          "command": "codea-air-code.deleteAsset",
          "when": "false"
        },
        {
          "command": "codea-air-code.linkAssetPack",
          "when": "false"
        },
        {
          "command": "codea-air-code.revealAssetPack",
          "when": "false"
        },
        {
          "command": "codea-air-code.unlinkFolder",
          "when": "codea-air-code.isLinked"
        },
        {
          "command": "codea-air-code.resolveConflicts",
          "when": "codea-air-code.isLinked"
        }
      ],
      "explorer/context": [
        {
          "command": "codea-air-code.linkFolder",
          "when": "explorerResourceIsFolder && resourceScheme == file && !(resourcePath in codea-air-code.linkedFolders)",
          "group": "a_codea"
        },
        {
          "command": "codea-air-code.unlinkFolder",
          "when": "explorerResourceIsFolder && resourcePath in codea-air-code.linkedFolders",
          "group": "a_codea"
        },
        {
          "command": "codea-air-code.newProject",
          "when": "explorerResourceIsFolder && resourceScheme == file && codea-air-code.hasLocalHost",
          "group": "a_codea"
        },
        {
          "command": "codea-air-code.deleteProject",
          "when": "explorerResourceIsFolder && resourceScheme == file && resourceFilename =~ /\\.codea$/ && codea-air-code.hasLocalHost",
          "group": "a_codea"
        }
      ],
      "view/title": [
        {
          "command": "codea-air-code.getAllProjects",
          "when": "view == codea-projects && codea-air-code.hasLocalHost",
          "group": "navigation"
        },
        {
          "command": "codea-air-code.syncLinkedFolders",
          "when": "view == workbench.explorer.fileView && codea-air-code.isLinked",
          "group": "navigation"
        },
        {
          "command": "codea-air-code.showLinkedProjectsOnly",
          "when": "view == codea-projects && !codea-air-code.projectsLinkedOnly",
          "group": "navigation"
        },
        {
          "command": "codea-air-code.showAllProjects",
          "when": "view == codea-projects && codea-air-code.projectsLinkedOnly",
          "group": "navigation"
        },
        {
          "command": "codea-air-code.refreshProjects",
          "when": "view == codea-projects",
          "group": "navigation"
        },
        {
          "command": "codea-air-code.linkAllFolders",
          "when": "view == codea-projects",
          "group": "links"
        },
        {
          "command": "codea-air-code.newProject",
          "when": "view == workbench.explorer.fileView && codea-air-code.hasLocalHost",
          "group": "navigation"
        },
        {
          "command": "codea-air-code.newProject",
          "when": "view == codea-projects && codea-air-code.hasLocalHost",
          "group": "navigation"
        },
        {
          "command": "codea-air-code.refreshAssets",
          "when": "view == codea-assets",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codea-air-code.getProject",
          "when": "view == codea-projects && viewItem == project",
          "group": "inline"
        },
        {
          "command": "codea-air-code.playProject",
          "when": "view == codea-projects && viewItem == linkedProject",
          "group": "inline"
        },
        {
          "command": "codea-air-code.revealProject",
          "when": "view == codea-projects && viewItem == linkedProject",
          "group": "inline"
        },
        {
          "command": "codea-air-code.getCollectionProjects",
          "when": "view == codea-projects && viewItem == collection",
          "group": "inline"
        },
        {
          "command": "codea-air-code.newProject",
          "when": "view == codea-projects && viewItem == collection",
          "group": "inline"
        },
        {
          "command": "codea-air-code.unlinkFolder",
          "when": "view == codea-projects && viewItem == linkedProject",
          "group": "y_link"
        },
        {
          "command": "codea-air-code.deleteProject",
          "when": "view == codea-projects && viewItem =~ /^(project|linkedProject)$/",
          "group": "z_delete"
        },
        {
          "command": "codea-air-code.removeDependency",
          "when": "view == codea-projects && viewItem == dependency",
          "group": "inline"
        },
        {
          "command": "codea-air-code.addDependency",
          "when": "view == codea-projects && viewItem == linkedProject",
          "group": "dependencies"
        },
        {
          "command": "codea-air-code.addAssetFiles",
          "when": "view == codea-assets && viewItem =~ /^writable (linked )?asset(Pack|Folder)$/",
          "group": "inline"
        },
        {
          "command": "codea-air-code.renameAsset",
          "when": "view == codea-assets && viewItem =~ /^writable asset/ && viewItem != 'writable assetPack'",
          "group": "edit@1"
        },
        {
          "command": "codea-air-code.deleteAsset",
          "when": "view == codea-assets && viewItem =~ /^writable asset/ && viewItem != 'writable assetPack'",
          "group": "edit@2"
        },
        {
          "command": "codea-air-code.linkAssetPack",
          "when": "view == codea-assets && viewItem == 'writable assetPack'",
          "group": "inline"
        },
        {
          "command": "codea-air-code.revealAssetPack",
          "when": "view == codea-assets && viewItem =~ /linked assetPack$/",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Codea Air Code",
      "properties": {
        "codea-air-code.host": {
          "type": "string",
          "scope": "resource",
          "description": "Codea's Air Code address (host:port) for linked folders."
        },
        "codea-air-code.links": {
          "type": "object",
          "scope": "resource",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Local folders kept in sync with Codea projects, from a path relative to the workspace folder to the project in Codea, e.g. \"iPad Projects/EmuTests\"."
        }
      }
    },
    "icons": {
      "codea-logo": {
        "description": "Codea logo",
        "default": {
          "fontPath": "resources/icons/codea-icons.woff",
          "fontCharacter": "\\E000"
        }
      },
      "codea-new": {
        "description": "New Codea project",
        "default": {
          "fontPath": "resources/icons/codea-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "codea-projects",
        "contents": "Connect to Codea to see its projects. A project you get from Codea is kept in a folder here and stays in sync with the device.\n[Connect to Codea](command:codea-air-code.connect)"
      }
    ],
    "walkthroughs": [
      {
        "id": "linkedFolders",
        "title": "Working with Codea Projects",
        "description": "Keep your Codea projects in a folder on your computer, in sync with Codea.",
        "steps": [
          {
            "id": "openFolder",
            "title": "Open a folder for your projects",
            "description": "Codea Air Code now works with folders on your computer. Each project is kept in a local folder that stays in sync with Codea, so search, source control and AI coding assistants work with your projects.\nOpen an empty folder to start, or one you already have, such as a git repository of Codea projects.\n[Open Folder](command:workbench.action.files.openFolder)",
            "media": {
              "image": "media/walkthrough/folder.png",
              "altText": "A folder of Codea projects in the Explorer"
            },
            "completionEvents": [
              "onContext:codea-air-code.walkthroughFolderReady",
              "onCommand:workbench.action.files.openFolder"
            ]
          },
          {
            "id": "connect",
            "title": "Connect to Codea",
            "description": "In Codea, tap the Air Code button on the projects screen to see its address. Once connected, the Projects section of the Codea sidebar lists the projects on your device.\n[Connect to Codea](command:codea-air-code.connect)",
            "media": {
              "image": "media/walkthrough/projects.png",
              "altText": "The Projects section of the Codea sidebar"
            },
            "completionEvents": [
              "onContext:codea-air-code.walkthroughConnected",
              "onSettingChanged:codea-air-code.host",
              "onCommand:codea-air-code.connect"
            ]
          },
          {
            "id": "getProject",
            "title": "Get a project",
            "description": "Click the download button next to a project to copy it into your folder, where it stays in sync with Codea. Projects are kept the way Codea keeps them: Project.codea for Documents, and Collection/Project.codea for other collections.\n[Show Projects](command:codea-projects.focus)",
            "media": {
              "image": "media/walkthrough/get.png",
              "altText": "Getting a project from Codea"
            },
            "completionEvents": [
              "onContext:codea-air-code.walkthroughLinked",
              "onCommand:codea-air-code.getProject"
            ]
          },
          {
            "id": "linkFolder",
            "title": "Already have the files?",
            "description": "If your folder already holds a project, for example from a git repository, right-click its folder in the Explorer and choose Link Folder to Project. The files on both sides are compared before anything is copied.\n[Link a Folder](command:codea-air-code.linkFolder)",
            "media": {
              "markdown": "media/walkthrough/link.md"
            },
            "completionEvents": [
              "onContext:codea-air-code.walkthroughLinked",
              "onCommand:codea-air-code.linkFolder"
            ]
          },
          {
            "id": "newProject",
            "title": "Create a project",
            "description": "Click the New Project button at the top of the Explorer, or right-click a folder and choose New Project. The project is created in Codea and copied into your folder, linked. Renaming the folder renames the project in Codea.\n[New Project](command:codea-air-code.newProject)",
            "media": {
              "markdown": "media/walkthrough/new.md"
            },
            "completionEvents": [
              "onCommand:codea-air-code.newProject"
            ]
          },
          {
            "id": "edit",
            "title": "Edit with any tool",
            "description": "Files you save, and files changed by other tools, are sent to Codea right away. Changes made in Codea come back within a second. If a file changes on both sides, you choose which version to keep, and can compare them first.\nYour projects are regular files, so you can [search](command:workbench.action.findInFiles) them, track them with source control, and work on them with AI coding assistants.",
            "media": {
              "image": "media/walkthrough/edit.png",
              "altText": "Searching a linked project"
            },
            "completionEvents": [
              "onCommand:workbench.action.findInFiles"
            ]
          },
          {
            "id": "play",
            "title": "Play and debug",
            "description": "The Codea items in the status bar show the connection and play the project you are working on. Breakpoints set in your files stop the project on the device, and the Parameters section controls it while it runs.\n[Play in Codea](command:workbench.action.debug.start)",
            "media": {
              "image": "media/walkthrough/play.png",
              "altText": "Playing a project from the status bar"
            },
            "completionEvents": [
              "onCommand:workbench.action.debug.start"
            ]
          },
          {
            "id": "assets",
            "title": "Work with assets",
            "description": "The Assets section of the Codea sidebar lists your asset packs. Drag an asset into a Lua file to insert its key, drop files on Documents to add them, or link a pack to keep it in your folder as ordinary files.\n[Show Assets](command:codea-assets.focus)",
            "media": {
              "markdown": "media/walkthrough/assets.md"
            },
            "completionEvents": [
              "onCommand:codea-assets.focus",
              "onCommand:codea-air-code.linkAssetPack"
            ]
          },
          {
            "id": "goToDefinition",
            "title": "Go to definitions",
            "description": "Install the Lua extension to jump to the definition of a function, a class or a Codea API, in your tabs, your linked dependencies and Codea's reference.\n[Set Up Go to Definition](command:codea-air-code.setUpGoToDefinition)",
            "media": {
              "markdown": "media/walkthrough/definitions.md"
